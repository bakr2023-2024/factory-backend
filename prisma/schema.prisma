// This is your Prisma schema file

generator client {
  provider     = "prisma-client"
  output       = "../src/db/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------------------
// User
// --------------------------------------------------
enum Role {
  ADMIN
  USER
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  number    String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --------------------------------------------------
// Items
// --------------------------------------------------

enum ItemType {
  PRODUCT
  MATERIAL
}

model Item {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  type      ItemType
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants Variant[]
}

// --------------------------------------------------
// Variants
// --------------------------------------------------

model Variant {
  id         Int      @id @default(autoincrement())
  itemId     Int
  unitWeight Decimal  @default(1) @db.Decimal(6, 3)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  item                Item                 @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stockMovements      StockMovement[]
  importItems         ImportItem[]
  exportItems         ExportItem[]
  productionEntries   ProductionEntry[]
  consumptions        Consumption[]
  customerReturnItems CustomerReturnItem[]
  supplierReturnItems SupplierReturnItem[]

  @@unique([itemId, unitWeight])
}

// --------------------------------------------------
// Stock Movements
// --------------------------------------------------

enum StockMovementType {
  IMPORT
  EXPORT
  PRODUCTION
  CONSUMPTION
}

model StockMovement {
  id              Int               @id @default(autoincrement())
  variantId       Int
  quantityChanged Int
  occurredAt      DateTime          @default(now())
  type            StockMovementType
  typeRef         Int?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  variant Variant @relation(fields: [variantId], references: [id])
}

// --------------------------------------------------
// Suppliers
// --------------------------------------------------

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  number    String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imports         Import[]
  supplierReturns SupplierReturn[]
}

model SupplierReturn {
  id         Int      @id @default(autoincrement())
  supplierId Int
  notes      String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier            Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierReturnItems SupplierReturnItem[]
}

model SupplierReturnItem {
  id               Int      @id @default(autoincrement())
  supplierReturnId Int
  variantId        Int
  quantity         Int
  unitPrice        Decimal  @default(1) @db.Decimal(9, 3)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplierReturn SupplierReturn @relation(fields: [supplierReturnId], references: [id], onDelete: Restrict)
  variant        Variant        @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([supplierReturnId, variantId])
}

// --------------------------------------------------
// Imports
// --------------------------------------------------

model Import {
  id         Int      @id @default(autoincrement())
  supplierId Int
  notes      String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier    Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  importItems ImportItem[]
}

model ImportItem {
  id        Int      @id @default(autoincrement())
  importId  Int
  variantId Int
  quantity  Int
  unitPrice Decimal  @default(1) @db.Decimal(9, 3)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  import  Import  @relation(fields: [importId], references: [id], onDelete: Restrict)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([importId, variantId])
}

// --------------------------------------------------
// Customers
// --------------------------------------------------

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  number    String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exports         Export[]
  customerReturns CustomerReturn[]
}

model CustomerReturn {
  id         Int      @id @default(autoincrement())
  customerId Int
  notes      String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerReturnItems CustomerReturnItem[]
}

model CustomerReturnItem {
  id               Int      @id @default(autoincrement())
  customerReturnId Int
  variantId        Int
  quantity         Int
  unitPrice        Decimal  @default(1) @db.Decimal(9, 3)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customerReturn CustomerReturn @relation(fields: [customerReturnId], references: [id], onDelete: Restrict)
  variant        Variant        @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([customerReturnId, variantId])
}

// --------------------------------------------------
// Exports
// --------------------------------------------------

model Export {
  id         Int      @id @default(autoincrement())
  customerId Int
  notes      String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  exportItems ExportItem[]
}

model ExportItem {
  id        Int      @id @default(autoincrement())
  exportId  Int
  variantId Int
  quantity  Int
  unitPrice Decimal  @default(1) @db.Decimal(9, 3)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  export  Export  @relation(fields: [exportId], references: [id], onDelete: Restrict)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([exportId, variantId])
}

// --------------------------------------------------
// Seasons
// --------------------------------------------------

model Season {
  id        Int       @id @default(autoincrement())
  startDate DateTime  @default(now()) @db.Date
  endDate   DateTime? @db.Date
  name      String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  weeks Week[]
}

// --------------------------------------------------
// Weeks
// --------------------------------------------------

model Week {
  id        Int       @id @default(autoincrement())
  seasonId  Int
  startDate DateTime  @default(now()) @db.Date
  endDate   DateTime? @db.Date
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  season         Season          @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  productionDays ProductionDay[]
}

// --------------------------------------------------
// Production Days
// --------------------------------------------------

model ProductionDay {
  id             Int       @id @default(autoincrement())
  productionDate DateTime  @default(now()) @db.Date
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  weekId         Int
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  week              Week              @relation(fields: [weekId], references: [id], onDelete: Restrict)
  productionEntries ProductionEntry[]
  consumptions      Consumption[]

  @@unique([productionDate, weekId])
}

// --------------------------------------------------
// Production Entries
// --------------------------------------------------

model ProductionEntry {
  id              Int      @id @default(autoincrement())
  productionDayId Int
  variantId       Int
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productionDay ProductionDay     @relation(fields: [productionDayId], references: [id], onDelete: Restrict)
  variant       Variant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  batches       ProductionBatch[]

  @@unique([productionDayId, variantId])
}

// --------------------------------------------------
// Production Batches
// --------------------------------------------------

model ProductionBatch {
  id                Int      @id @default(autoincrement())
  productionEntryId Int
  quantity          Int
  occurredAt        DateTime @default(now())
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productionEntry ProductionEntry @relation(fields: [productionEntryId], references: [id], onDelete: Restrict)
}

// --------------------------------------------------
// Consumption
// --------------------------------------------------

model Consumption {
  id              Int      @id @default(autoincrement())
  productionDayId Int
  variantId       Int
  quantity        Int
  occurredAt      DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productionDay ProductionDay @relation(fields: [productionDayId], references: [id], onDelete: Restrict)

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([productionDayId, variantId])
}
