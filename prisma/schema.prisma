// This is your Prisma schema file

generator client {
  provider     = "prisma-client"
  output       = "../src/db/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------------------
// User
// --------------------------------------------------
enum Role {
  ADMIN
  USER
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  number    String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --------------------------------------------------
// Items
// --------------------------------------------------

enum ItemType {
  PRODUCT
  MATERIAL
}

model Item {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  type      ItemType
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants Variant[]
}

// --------------------------------------------------
// Variants
// --------------------------------------------------

model Variant {
  id           Int      @id @default(autoincrement())
  itemId       Int
  currentStock Int      @default(0)
  unitWeight   Decimal  @default(1) @db.Decimal(6, 3)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  item              Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stockMovements    StockMovement[]
  importItems       ImportItem[]
  exportItems       ExportItem[]
  productionEntries ProductionEntry[]
  consumptions      Consumption[]

  @@unique([itemId, unitWeight])
}

// --------------------------------------------------
// Stock Movements
// --------------------------------------------------

enum StockMovementType {
  IMPORT_ITEM
  EXPORT_ITEM
  PRODUCTION_BATCH
  CONSUMPTION
  CUSTOMER_RETURN_ITEM
  SUPPLIER_RETURN_ITEM
}

model StockMovement {
  id              Int               @id @default(autoincrement())
  productionDayId Int
  variantId       Int
  quantityChanged Int
  occurredAt      DateTime          @default(now())
  type            StockMovementType
  typeRef         Int
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  productionDay ProductionDay @relation(fields: [productionDayId], references: [id])
  variant       Variant       @relation(fields: [variantId], references: [id])

  @@unique([type, typeRef])
}

// --------------------------------------------------
// Suppliers
// --------------------------------------------------

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  number    String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imports         Import[]
  supplierReturns SupplierReturn[]
}

model SupplierReturn {
  id              Int      @id @default(autoincrement())
  supplierId      Int
  productionDayId Int
  notes           String?
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier            Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  productionDay       ProductionDay        @relation(fields: [productionDayId], references: [id], onDelete: Restrict)
  supplierReturnItems SupplierReturnItem[]
}

model SupplierReturnItem {
  id               Int      @id @default(autoincrement())
  supplierReturnId Int
  importItemId     Int      @unique
  quantity         Int
  unitPrice        Decimal  @default(1) @db.Decimal(9, 3)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplierReturn SupplierReturn @relation(fields: [supplierReturnId], references: [id], onDelete: Restrict)
  importItem     ImportItem     @relation(fields: [importItemId], references: [id], onDelete: Restrict)

  @@unique([supplierReturnId, importItemId])
}

// --------------------------------------------------
// Imports
// --------------------------------------------------

model Import {
  id              Int      @id @default(autoincrement())
  supplierId      Int
  productionDayId Int
  notes           String?
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  productionDay ProductionDay @relation(fields: [productionDayId], references: [id], onDelete: Restrict)
  importItems   ImportItem[]
}

model ImportItem {
  id        Int      @id @default(autoincrement())
  importId  Int
  variantId Int
  quantity  Int
  unitPrice Decimal  @default(1) @db.Decimal(9, 3)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  import  Import  @relation(fields: [importId], references: [id], onDelete: Restrict)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  supplierReturnItem SupplierReturnItem?

  @@unique([importId, variantId])
}

// --------------------------------------------------
// Customers
// --------------------------------------------------

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  number    String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exports         Export[]
  customerReturns CustomerReturn[]
}

model CustomerReturn {
  id              Int      @id @default(autoincrement())
  customerId      Int
  productionDayId Int
  notes           String?
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  productionDay       ProductionDay        @relation(fields: [productionDayId], references: [id], onDelete: Restrict)
  customerReturnItems CustomerReturnItem[]
}

model CustomerReturnItem {
  id               Int      @id @default(autoincrement())
  customerReturnId Int
  exportItemId     Int      @unique
  quantity         Int
  unitPrice        Decimal  @default(1) @db.Decimal(9, 3)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customerReturn CustomerReturn @relation(fields: [customerReturnId], references: [id], onDelete: Restrict)
  exportItem     ExportItem     @relation(fields: [exportItemId], references: [id], onDelete: Restrict)

  @@unique([customerReturnId, exportItemId])
}

// --------------------------------------------------
// Exports
// --------------------------------------------------

model Export {
  id              Int      @id @default(autoincrement())
  customerId      Int
  productionDayId Int
  notes           String?
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  productionDay ProductionDay @relation(fields: [productionDayId], references: [id], onDelete: Restrict)
  exportItems   ExportItem[]
}

model ExportItem {
  id        Int      @id @default(autoincrement())
  exportId  Int
  variantId Int
  quantity  Int
  unitPrice Decimal  @default(1) @db.Decimal(9, 3)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  export  Export  @relation(fields: [exportId], references: [id], onDelete: Restrict)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  customerReturnItem CustomerReturnItem?

  @@unique([exportId, variantId])
}

// --------------------------------------------------
// Seasons
// --------------------------------------------------
enum SeasonKind {
  NORMAL
  SPECIAL
}

model Season {
  id        Int         @id @default(autoincrement())
  startDate DateTime    @default(now()) @db.Date
  endDate   DateTime?   @db.Date
  name      String?
  kind      SeasonKind? @default(NORMAL)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  weeks Week[]
  rates Rate[]
  loans Loan[]
}

// --------------------------------------------------
// Weeks
// --------------------------------------------------

model Week {
  id        Int       @id @default(autoincrement())
  seasonId  Int
  startDate DateTime  @default(now()) @db.Date
  endDate   DateTime? @db.Date
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  season         Season          @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  productionDays ProductionDay[]
}

// --------------------------------------------------
// Production Days
// --------------------------------------------------

model ProductionDay {
  id             Int       @id @default(autoincrement())
  productionDate DateTime  @default(now()) @db.Date
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  weekId         Int
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  week              Week              @relation(fields: [weekId], references: [id], onDelete: Restrict)
  productionEntries ProductionEntry[]
  imports           Import[]
  exports           Export[]
  consumptions      Consumption[]
  stockMovements    StockMovement[]
  customerReturns   CustomerReturn[]
  supplierReturns   SupplierReturn[]
  attendances       Attendance[]

  @@unique([productionDate, weekId])
}

// --------------------------------------------------
// Production Entries
// --------------------------------------------------

model ProductionEntry {
  id              Int      @id @default(autoincrement())
  productionDayId Int
  variantId       Int
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productionDay ProductionDay     @relation(fields: [productionDayId], references: [id], onDelete: Restrict)
  variant       Variant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  batches       ProductionBatch[]

  @@unique([productionDayId, variantId])
}

// --------------------------------------------------
// Production Batches
// --------------------------------------------------

model ProductionBatch {
  id                Int      @id @default(autoincrement())
  productionEntryId Int
  quantity          Int
  occurredAt        DateTime @default(now())
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productionEntry ProductionEntry @relation(fields: [productionEntryId], references: [id], onDelete: Restrict)
}

// --------------------------------------------------
// Consumption
// --------------------------------------------------

model Consumption {
  id              Int      @id @default(autoincrement())
  productionDayId Int
  variantId       Int
  quantity        Int
  occurredAt      DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productionDay ProductionDay @relation(fields: [productionDayId], references: [id], onDelete: Restrict)

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([productionDayId, variantId])
}

// --------------------------------------------------
// Laborers
// --------------------------------------------------

model Laborer {
  id        Int      @id @default(autoincrement())
  name      String
  number    String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates       Rate[]
  attendances Attendance[]
  loans       Loan[]
}

// --------------------------------------------------
// Rates
// --------------------------------------------------

enum PaymentType {
  WEEKLY
  MONTHLY
  SEASON_END
}

model Rate {
  id          Int         @id @default(autoincrement())
  laborerId   Int
  seasonId    Int
  dailySalary Decimal     @db.Decimal(9, 3)
  paymentType PaymentType
  from        DateTime    @db.Date
  to          DateTime?   @db.Date
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  laborer  Laborer   @relation(fields: [laborerId], references: [id], onDelete: Restrict)
  season   Season    @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  payments Payment[]
}

// --------------------------------------------------
// Attendance
// --------------------------------------------------

model Attendance {
  id              Int       @id @default(autoincrement())
  laborerId       Int
  productionDayId Int
  cameAt          DateTime  @default(now())
  leftAt          DateTime?
  factor          Decimal?  @db.Decimal(3, 2)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  laborer       Laborer       @relation(fields: [laborerId], references: [id], onDelete: Restrict)
  productionDay ProductionDay @relation(fields: [productionDayId], references: [id], onDelete: Restrict)

  @@unique([laborerId, productionDayId])
}

// --------------------------------------------------
// Loans
// --------------------------------------------------

model Loan {
  id         Int      @id @default(autoincrement())
  laborerId  Int
  seasonId   Int
  loanAmount Decimal  @db.Decimal(12, 3)
  loanedAt   DateTime @default(now())
  paymentId  Int?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  laborer      Laborer       @relation(fields: [laborerId], references: [id], onDelete: Restrict)
  season       Season        @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  payment      Payment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  loanPayments LoanPayment[]
}

// --------------------------------------------------
// Loan Payments (repayments of a loan)
// --------------------------------------------------

model LoanPayment {
  id        Int      @id @default(autoincrement())
  loanId    Int
  paymentId Int?
  amount    Decimal  @db.Decimal(12, 3)
  repaidAt  DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loan    Loan     @relation(fields: [loanId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

// --------------------------------------------------
// Payments
// --------------------------------------------------

model Payment {
  id           Int       @id @default(autoincrement())
  rateId       Int
  gross        Decimal   @db.Decimal(12, 3)
  loans        Decimal   @db.Decimal(12, 3)
  loanPayments Decimal   @db.Decimal(12, 3)
  net          Decimal   @db.Decimal(12, 3)
  paidAt       DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  rate        Rate          @relation(fields: [rateId], references: [id], onDelete: Restrict)
  loanRecords Loan[]
  repayments  LoanPayment[]
}
